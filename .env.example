# Copy to a local, UNCOMMITTED file and pass values as --dart-define flags.
# None of these are required to build or play: debug builds use Google's
# public test ad units; release builds disable ads unless IDs are provided.

# AdMob ad units (Dart side, via --dart-define)
ADMOB_REWARDED_ANDROID=
ADMOB_INTERSTITIAL_ANDROID=
ADMOB_REWARDED_IOS=
ADMOB_INTERSTITIAL_IOS=
ADMOB_BANNER_ANDROID=
ADMOB_BANNER_IOS=
ADS_ENABLED=true

# AdMob APP ids (native side)
#   Android: gradle property  -PADMOB_APP_ID_ANDROID=ca-app-pub-xxxxxxxx~yyyyyyyy
#   iOS:     ios/Flutter/AdMob.xcconfig  ->  GAD_APP_ID=ca-app-pub-xxxxxxxx~yyyyyyyy

PRIVACY_POLICY_URL=https://example.com/privacy
APP_VERSION=0.1.0
