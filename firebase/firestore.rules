rules_version = '2';
// Solitaire Nova — Firestore security rules (template, not deployed).
//
// Model: users/{uid} holds ONLY the owner's private backup documents.
// Public leaderboards are intentionally NOT exposed to clients: scores sent
// by a client cannot be trusted. A leaderboard must be written by a Cloud
// Function that re-validates the submitted move log against the seed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['schemaVersion', 'updatedAt', 'deviceId'])
        && request.resource.data.schemaVersion is int
        && request.resource.data.updatedAt is timestamp;

      // Profile backup (coins, stats, achievements, cosmetics) — opaque to
      // other users; size-limited; monotonic version for conflict detection.
      match /backup/{docId} {
        allow read, delete: if isOwner(uid);
        allow write: if isOwner(uid)
          && docId in ['profile', 'current_game']
          && request.resource.data.keys().hasOnly(['schemaVersion', 'version', 'updatedAt', 'payload'])
          && request.resource.data.version is int
          && (resource == null || request.resource.data.version > resource.data.version)
          && request.resource.data.payload is string
          && request.resource.data.payload.size() < 200000;
      }
    }

    // Server-only collections (Cloud Functions use the Admin SDK and bypass
    // these rules). Clients may read the validated leaderboard only.
    match /leaderboards/{board}/entries/{entry} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
